# ============================================================================
# Copy to .env and fill in. .env is gitignored — never commit real keys.
#     cp .env.example .env
#
# The only value you must supply is MESHAPI_API_KEY. Everything else has a
# working default, and the app runs without a key at all (see LLM_ENABLED).
# ============================================================================

APP_ENV=development
BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Mesh API (required for live AI) ---------------------------------------
# Get a key from the Mesh dashboard; it starts with rsk_.
# MESH_API_KEY is accepted as an alias, which is the GitHub secret name the
# hackathon brief asks for.
MESHAPI_API_KEY=rsk_your_key_here
MESHAPI_BASE_URL=https://api.meshapi.ai/v1

# Measured on this gateway (see README "Model selection"):
#   openai/gpt-4o-mini    1.8s, 142 completion tokens, no reasoning overhead
#   moonshotai/kimi-k3   12.7s, 396 completion tokens (220 reasoning), better copy
# Use gpt-4o-mini for development, switch MESHAPI_MODEL for a demo recording.
MESHAPI_MODEL=openai/gpt-4o-mini
MESHAPI_MODEL_FAST=openai/gpt-4o-mini
MESHAPI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Generous, because a reasoning model can spend a minute thinking before it answers.
MESHAPI_TIMEOUT_SECONDS=90

# Reasoning models spend hidden tokens before emitting visible text. Too low a
# ceiling returns a successful, empty response.
LLM_MAX_OUTPUT_TOKENS=4000

# Spend guardrails. LLM_ENABLED=false runs the whole app offline with a
# deterministic embedder and template copy — useful for tests and demos.
LLM_ENABLED=true
LLM_DAILY_BUDGET_USD=1.00
LLM_MAX_CALLS_PER_USER_PER_DAY=25

# ---- Database ---------------------------------------------------------------
DATABASE_URL=sqlite+pysqlite:///./data/smartreco.db
# Postgres:
# DATABASE_URL=postgresql+psycopg://smartreco:smartreco@localhost:5432/smartreco

# ---- Vector store -----------------------------------------------------------
# Chroma locally, Pinecone when deployed. Chroma is a file on disk: no account, no
# network, and it is what the test suite and CI run against. Pinecone is the managed
# path — one shared index that outlives the container. docker-compose.yml flips this
# to pinecone on its own; this file is the local template.
VECTOR_BACKEND=chroma
CHROMA_DIR=./data/chroma
EMBEDDING_DIM=1536

# Only when VECTOR_BACKEND=pinecone
PINECONE_API_KEY=
PINECONE_INDEX=smartreco
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Optional: isolate this deployment inside a shared index.
PINECONE_NAMESPACE=

# ---- Event ingest -------------------------------------------------------------
# The queue is bounded on purpose: under a flood the right move is to shed telemetry
# and keep serving pages, not to grow a queue until the process dies. Drops are
# counted, not silent. A batch flushes on whichever limit is hit first.
EVENT_QUEUE_MAX=20000
EVENT_FLUSH_BATCH=500
EVENT_FLUSH_INTERVAL_SECONDS=1.0
# Rejects an oversized POST body; the browser chunks its stash drain to match.
EVENT_MAX_BATCH_SIZE=100

# ---- Behaviour profile --------------------------------------------------------
# Every event's weight halves each half-life, so a topic abandoned last week cannot
# outvote what someone is reading now — without one session erasing a month of it.
PROFILE_HALFLIFE_HOURS=48
PROFILE_LOOKBACK_DAYS=30
PROFILE_MAX_EVENTS=400

# ---- Recommendation trigger policy ------------------------------------------
# These decide when an LLM call is worth making. See README "Trigger policy".
REC_MIN_EVENTS=5
REC_COOLDOWN_SECONDS=90
REC_DRIFT_THRESHOLD=0.10
REC_STALENESS_EVENTS=15
REC_TTL_MINUTES=120
REC_TOP_K=4

# ---- Retrieval --------------------------------------------------------------
RETRIEVAL_CANDIDATES=40
RETRIEVAL_MMR_LAMBDA=0.65
RETRIEVAL_GRADE_THRESHOLD=0.60
RETRIEVAL_MAX_REFINES=2
# Swept, not guessed — see README. Keep in step with app/config.py.
RETRIEVAL_SCORE_RATIO=0.55
RETRIEVAL_MIN_SCORE=0.10
# The grade node re-ranks in the same call it scores retrieval with, so this is free.
RETRIEVAL_RERANK=true

# ---- Agent --------------------------------------------------------------------
AGENT_MODE=langgraph

# ---- Email digest -----------------------------------------------------------
# Leave SMTP_HOST empty and digests render to ./data/outbox/*.html instead of
# sending — same templates, same scheduling, no credentials required.
MAIL_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=SmartReco <no-reply@smartreco.local>
DIGEST_HOUR=16
DIGEST_MINUTE=0
DIGEST_MIN_EVENTS=3

# ---- Background jobs ----------------------------------------------------------
# Off in tests. The outbox drain pushes pending vector writes; reconcile diffs SQL
# against the index by content hash and repairs drift in both directions.
SCHEDULER_ENABLED=true
OUTBOX_INTERVAL_SECONDS=60
RECONCILE_INTERVAL_MINUTES=60

# ---- Guardrails -------------------------------------------------------------
# Deterministic rails always run and cost nothing. NeMo Guardrails is an
# optional second layer that spends tokens per generation.
GUARDRAILS_LLM_ENABLED=false

# ---- Observability ----------------------------------------------------------
# Two backends, both optional, both no-ops without credentials.
#   LangSmith -> the agent graph: which node ran, the prompt, why verify rejected a draft
#   Logfire   -> the request around it: HTTP span, SQL, Mesh call + token count
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartreco

# Logfire needs a sink. With no token and LOGFIRE_CONSOLE=false it is skipped with a
# warning rather than silently building spans nobody receives.
LOGFIRE_ENABLED=false
LOGFIRE_TOKEN=
LOGFIRE_PROJECT_NAME=smartreco
LOGFIRE_CONSOLE=false
# LangGraph spans reach Logfire through LangSmith's OTel bridge (tracing_mode=hybrid),
# so one run shows up in both places. Needs Logfire running; ignored otherwise.
LOGFIRE_INSTRUMENT_LANGCHAIN=true

# ---- AWS (only for MAIL_BACKEND=ses) ----------------------------------------
AWS_REGION=us-east-1
